// ANALIZADOR SINTACTICO
package eli.compiler;

import java_cup.runtime.*;
import java.util.*;

// TERMINALES (TOKENS)
terminal           DATABASE, TABLE, READ, ADD, UPDATE, EXPORT, USE, CLEAR;      // Palabras reservadas de ELI
terminal           FIELDS, FILTER, SET, STORE, AT;                              // Palabras para clausulas internas
terminal           INT, FLOAT, STRING, BOOL, ARRAY, OBJECT, NULL;               // Tipos de datos (tablas)
terminal           EQ, NEQ, GT, LT, GTE, LTE;                                   // Operadores relacionales (filtros)
terminal           AND, OR, NOT;                                                // Operadores logicos
terminal           LBRACE, RBRACE, LPAREN, RPAREN, LBRACKET, RBRACKET;          // Signos de agrupacion y puntuacion
terminal           SEMICOLON, COLON, COMMA, DOT, ASSIGN, STAR;
terminal           IDENTIFICADOR;                                               // Identificadores y valores
terminal Integer   ENTERO;
terminal Double    DECIMAL;
terminal String    STRING_LITERAL;
terminal Boolean   BOOLEAN;

// NO TERMINALES
non terminal program;
non terminal statement;
non terminal statement_list;
non terminal database_statement;
non terminal use_statement;
non terminal table_statement;
non terminal read_statement;
non terminal add_statement;
non terminal update_statement;
non terminal clear_statement;
non terminal export_statement;
non terminal store_statement;
non terminal field_list;
non terminal field;
non terminal type;
non terminal field_value_list;
non terminal field_value;
non terminal value;
non terminal field_selector;
non terminal filter_opt;
non terminal assignment_list;
non terminal assignment;
non terminal read_body;
non terminal update_body;
non terminal array_value_list;
non terminal array;
// REGLAS GRAMATICALES
program ::= statement_list;

statement_list ::= 
      statement_list statement
    | statement
    ;

statement ::= 
      database_statement
    | use_statement
    | table_statement
    | read_statement
    | add_statement
    | update_statement
    | clear_statement
    | export_statement
    ;

// --- DATABASE ---
database_statement ::= DATABASE IDENTIFICADOR LBRACE store_statement RBRACE;

store_statement ::= STORE AT STRING_LITERAL SEMICOLON;

// --- USE ---
use_statement ::= USE IDENTIFICADOR SEMICOLON;

// --- TABLE ---
table_statement ::= TABLE IDENTIFICADOR LBRACE field_list RBRACE;

field_list ::= 
      field_list field
    | field
    ;

field ::= IDENTIFICADOR COLON type SEMICOLON;

type ::= 
      INT
    | FLOAT
    | STRING
    | BOOL
    | ARRAY
    | OBJECT
    ;

// --- READ ---
read_statement ::= READ IDENTIFICADOR LBRACE read_body RBRACE SEMICOLON;

read_body ::= 
      FIELDS COLON field_selector SEMICOLON filter_opt
    | FIELDS COLON STAR SEMICOLON filter_opt
    ;

field_selector ::= 
      field_selector COMMA IDENTIFICADOR
    | IDENTIFICADOR
    ;

filter_opt ::= 
      FILTER COLON IDENTIFICADOR EQ value SEMICOLON
    | /* empty */
    ;

// --- ADD ---
add_statement ::= ADD IDENTIFICADOR LBRACE field_value_list RBRACE SEMICOLON;

field_value_list ::= 
      field_value_list COMMA field_value
    | field_value
    ;

field_value ::= IDENTIFICADOR COLON value;

value ::= 
      ENTERO
    | DECIMAL
    | STRING_LITERAL
    | BOOLEAN
    | array
    | NULL
    ;

// --- UPDATE ---
update_statement ::= UPDATE IDENTIFICADOR LBRACE update_body RBRACE SEMICOLON;

update_body ::= SET COLON assignment_list SEMICOLON filter_opt;

assignment_list ::= 
      assignment_list COMMA assignment
    | assignment
    ;

assignment ::= IDENTIFICADOR ASSIGN value;

// --- CLEAR ---
clear_statement ::= CLEAR IDENTIFICADOR SEMICOLON;

// --- EXPORT ---
export_statement ::= EXPORT STRING_LITERAL SEMICOLON;